require_relative 'conta'

class ContaRepository
  

  def initialize
    @contas = []
  end

  def validate?(conta)
    if @contas.any? { |c| c.cpf == conta.cpf || c.email == conta.email}
    return false
    else 
      return true
    end
  end

  

   def add(conta)
    if validate?(conta)
    @contas << conta
    end
  end

end